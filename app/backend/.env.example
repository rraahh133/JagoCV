# ============================================================
# BACKEND ENV — Salin file ini menjadi .env dan isi nilainya
# File .env TIDAK boleh di-commit ke Git
# ============================================================

# MySQL Connection String
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root@localhost:3306/jagocv"

# JWT Secret — ganti dengan string acak yang panjang di produksi
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="ganti-dengan-secret-yang-kuat-minimal-32-karakter"

# Google Gemini API Key
GEMINI_API_KEY=""

# Port backend (default: 5000)
PORT=5000

# CORS Origins — pisahkan dengan koma, tanpa spasi
# Development:
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"
# Production (ganti dengan domain asli):
# CORS_ORIGINS="https://domain-kamu.com"
