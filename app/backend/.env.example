# ============================================================
# BACKEND ENV — Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke Git
# ============================================================

# ------------------------------------------------------------
# DATABASE
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# ------------------------------------------------------------

# Laragon (default, tanpa password):
DATABASE_URL="mysql://root@localhost:3306/jagoai"

# phpMyAdmin / XAMPP (tanpa password):
# DATABASE_URL="mysql://root@127.0.0.1:3306/jagoai"

# phpMyAdmin / XAMPP (dengan password):
# DATABASE_URL="mysql://root:passwordkamu@127.0.0.1:3306/jagoai"

# Production hosting:
# DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/jagoai"

# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------

# JWT Secret — ganti dengan string acak yang panjang di production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="ganti-dengan-secret-yang-kuat-minimal-32-karakter"

# ------------------------------------------------------------
# AI
# ------------------------------------------------------------

# Google Gemini API Key — dapatkan di https://aistudio.google.com
GEMINI_API_KEY=""

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------

PORT=5000

# ------------------------------------------------------------
# CORS — Origins yang diizinkan mengakses API
# Pisahkan dengan koma, tanpa spasi
# ------------------------------------------------------------

# Development (lokal):
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Production (uncomment dan ganti dengan domain asli):
# CORS_ORIGINS="https://domain-kamu.com"
